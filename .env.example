GEMINI_API_KEY=your_gemini_api_key_here

# ── Neon Postgres ─────────────────────────────────────────────────────
# Owner connection (migrations, role management) — from the Neon console
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Read-write role used by the local pipeline (created by scripts/migrate_to_neon.py)
CRAWLER_DATABASE_URL=
# Read-only role used by the deployed admin panel (created by scripts/migrate_to_neon.py)
ADMIN_DATABASE_URL=
# Optional fixed passwords for the roles created by the migration
# (auto-generated and printed if left empty)
CRAWLER_DB_PASSWORD=
ADMIN_DB_PASSWORD=

# ── Cloudflare R2 (screenshots) ───────────────────────────────────────
# S3-compatible API token — R2 → Manage API tokens → Object Read & Write.
# Used by scripts/prepare_screenshots.py + upload_screenshots_r2.py.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lovable-parser-screenshots
# Public host screenshots are served from (custom domain or pub-xxxx.r2.dev).
# No scheme; the app prepends https://. See admin/SETUP.md.
IMG_DOMAIN=

# ── Admin panel login ─────────────────────────────────────────────────
# Hidden /admin/login route. Login is disabled until both are set.
ADMIN_USER=admin@admin.com
ADMIN_PASSWORD=
# Signs the session cookie — any long random string (falls back to
# ADMIN_PASSWORD if unset). Change it to invalidate all existing sessions.
AUTH_SECRET=

# Telegram bot — get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_CONCURRENCY=1

# Base URL where screenshots are served publicly (see nginx-screenshots.conf)
# Example: http://123.456.789.0
SCREENSHOT_BASE_URL=

# Free tier options (try in order if one gives limit: 0):
#   gemini-2.0-flash
#   gemini-1.5-flash-latest
#   gemini-1.5-flash-8b
#   gemini-2.5-flash-preview-04-17
# Paid upgrade:
#   gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Delete screenshot files after Gemini analysis to save disk space
# Set to true when running at scale (2000 sites ≈ ~500MB of screenshots)
DELETE_SCREENSHOTS_AFTER_ANALYSIS=false

# Playwright crawler — parallel browser tabs (each uses ~100MB RAM, max ~10)
CRAWL_CONCURRENCY=10
CRAWL_TIMEOUT=15000

# Optional: pin to a single CC index (omit to query all 26 indexes)
# Format: CC-MAIN-YYYY-NN  (see https://index.commoncrawl.org/)
# CC_INDEX=CC-MAIN-2026-17

# Also fetch from Wayback Machine (archive.org) — independent crawler, adds coverage
# Slower (extra HTTP requests) but finds sites CommonCrawl missed
USE_WAYBACK=false

# Concurrent requests per source (keep WB_CONCURRENCY low — archive.org rate-limits aggressively)
CC_CONCURRENCY=5
WB_CONCURRENCY=3

# Limit Wayback to N pages (0 = no limit). Used by the pipeline smoke test.
WB_MAX_PAGES=0

# Cap domains kept per source (0 = no limit). Used by the pipeline smoke test.
FETCH_LIMIT=0

# Gemini concurrent requests (free tier: keep at 3, paid: up to 10)
GEMINI_CONCURRENCY=3

# Mock Gemini: make 1 real request to verify API, then generate random responses for the rest
# Useful for pipeline smoke tests without burning through quota
GEMINI_MOCK=false

# Minimum design score to include in results export (0 = export everything)
# Example: MIN_SCORE=8 exports only sites scored 8 or above
MIN_SCORE=0
